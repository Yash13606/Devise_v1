# Live is the default. Use npm run dev:demo from the root for an explicit UI preview.
VITE_APP_MODE=live
# Trusted API origin. Browser requests never use database credentials.
VITE_API_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Root npm run dev:local injects VITE_APP_MODE=local and
# VITE_API_URL=http://127.0.0.1:8000. Local login requires Vite DEV plus
# loopback browser/API origins. A production build refuses local mode.
# Never put backend/database/device secrets in VITE_* settings.
