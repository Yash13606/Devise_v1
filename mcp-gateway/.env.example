# Thin adapter. Python API verifies identity and owns policy/execution.
FASTIFY_PORT=3001
DEVISE_API_URL=http://127.0.0.1:8000
DEVISE_GATEWAY_BIND=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
# Public binding requires APP_ENV=production and explicit DEVISE_GATEWAY_PUBLIC_HOST.
# No database credentials or upstream caller-token forwarding here.
