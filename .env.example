# Server only. npm run local:setup generates a separate ignored .env.local.
# Production uses Auth0 and the restricted PostgreSQL role in Supabase.
APP_ENV=production
DEVISE_AUTH_MODE=auth0
DATABASE_URL=
# Operator migration/provisioning jobs only; omit from the web process.
DATABASE_ADMIN_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
CORS_ORIGINS=https://your-frontend.example
# Random secret >=32 characters for encrypted execution storage. Never VITE_*.
DEVISE_PENDING_SECRET=
# Currently supported only for the local loopback HTTP fixture, not arbitrary SaaS.
DEVISE_MCP_UPSTREAM_URL=
