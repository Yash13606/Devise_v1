{
  "name": "devise-cad-workspace",
  "version": "1.0.0",
  "description": "Root workspace to launch all Devise-CAD microservices simultaneously",
  "scripts": {
    "install:all": "node scripts/dev.mjs install",
    "start": "node scripts/dev.mjs local",
    "dev:local": "node scripts/dev.mjs local",
    "local:setup": "node scripts/dev.mjs setup-local",
    "local:stop": "node scripts/dev.mjs stop-local",
    "local:status": "node scripts/dev.mjs status-local",
    "dev:preview": "node scripts/dev.mjs preview",
    "dev:fixture": "node scripts/dev.mjs fixture",
    "dev:demo": "node scripts/dev.mjs demo",
    "dev:api": "node scripts/dev.mjs api",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "dev:agent": "node scripts/dev.mjs agent",
    "preflight": "node scripts/dev.mjs check",
    "test:setup": "node --test scripts/dev.test.mjs",
    "test:prompts": "promptfoo test"
  },
  "devDependencies": {
    "promptfoo": "^0.99.0"
  }
}
